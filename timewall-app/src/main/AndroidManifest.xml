<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://schemas.android.com/apk/res/android ">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="TimeWall" android:icon="@mipmap/ic_launcher" android:allowBackup="false"
        android:fullBackupContent="false" android:dataExtractionRules="@xml/timewall_data_extraction_rules"
        android:usesCleartextTraffic="false" android:enableOnBackInvokedCallback="true"
        android:theme="@android:style/Theme.Holo.Light.NoActionBar">
        <activity android:name="it.timewall.app.ui.dashboard.DashboardActivity" android:exported="true"
            android:screenOrientation="landscape">
            <!-- Temporary target-36 landscape compatibility; removed for target 37.
                 See docs/android-compatibility.md before the next target upgrade. -->
            <property android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />
        </activity>
        <activity-alias android:name="it.timewall.diagnostics.DashboardActivity" android:targetActivity="it.timewall.app.ui.dashboard.DashboardActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <receiver android:name="it.timewall.app.ui.widget.WhatsNextWidget"
            android:label="@string/whats_next_widget_picker_label" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/whats_next_widget" />
        </receiver>
        <receiver android:name="it.timewall.app.ui.widget.AgendaWidget"
            android:label="@string/agenda_widget_picker_label" android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/agenda_widget" />
        </receiver>
        <receiver android:name="it.timewall.app.ui.widget.ClockWidget"
            android:label="@string/clock_widget_picker_label" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/clock_widget" />
        </receiver>
        <receiver android:name="it.timewall.app.ui.widget.WeatherWidget"
            android:label="@string/weather_widget_picker_label" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/weather_widget" />
        </receiver>
        <receiver android:name="it.timewall.app.ui.widget.WeatherWidget$InternalReceiver"
            android:exported="false" />
        <service android:name="it.timewall.app.ui.widget.WidgetWeatherRefresh$LegacyService"
            android:exported="false" />
        <service android:name="it.timewall.app.ui.widget.WidgetWeatherRefresh$BackgroundJob"
            android:exported="true" android:permission="android.permission.BIND_JOB_SERVICE" />
        <service android:name="it.timewall.app.ui.widget.AgendaWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS" android:exported="false" />
        <service android:name="it.timewall.app.ui.widget.WidgetCalendarRefresh$LegacyService"
            android:exported="false" />
        <service android:name="it.timewall.app.ui.widget.WidgetCalendarRefresh$BackgroundJob"
            android:exported="true" android:permission="android.permission.BIND_JOB_SERVICE" />
        <activity android:name="it.timewall.app.ui.widget.WhatsNextConfig" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
