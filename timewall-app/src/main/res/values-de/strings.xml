    <string name="calendar_cache_hint">Löscht lokale Kopien gespeicherter Kalender und startet eine Aktualisierung. Änderungen auf dieser Seite werden nicht gespeichert.</string>
    <string name="calendar_cache_cleared">Kalendercache geleert. Aktualisierung läuft…</string>
    <string name="calendar_cache_error">Der Kalendercache konnte nicht vollständig geleert werden.</string>
