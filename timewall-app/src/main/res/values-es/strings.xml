    <string name="calendar_cache_hint">Elimina las copias locales de los calendarios guardados e inicia una actualización. No guarda los cambios de esta pantalla.</string>
    <string name="calendar_cache_cleared">Caché de calendarios vaciada. Actualizando…</string>
    <string name="calendar_cache_error">No se pudo vaciar por completo la caché de calendarios.</string>
    <string name="clearing_calendar_cache">Vaciando caché de calendarios…</string>
    <string name="weather_attribution">Datos meteorológicos: Open-Meteo · CC BY 4.0</string>
