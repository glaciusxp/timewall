<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weather_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/whats_next_background"
        android:id="@+id/widget_background" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical|end">
            <ImageView
                android:id="@+id/weather_place_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:layout_marginRight="4dp" />
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:id="@+id/weather_place"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:visibility="gone" />
                <ImageView
                    android:id="@+id/weather_place_font"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:scaleType="centerInside"
                    android:visibility="gone" />
            </FrameLayout>
            <TextView
                android:id="@+id/weather_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/weather_updated_font"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerInside"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/weather_refresh"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:scaleType="centerInside"
                android:padding="6dp" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical|start">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/weather_wind_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:scaleType="fitCenter"
                            android:visibility="gone"
                            android:layout_marginRight="4dp" />
                        <TextView
                            android:id="@+id/weather_wind"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:visibility="gone" />
                        <ImageView
                            android:id="@+id/weather_wind_font"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleType="centerInside"
                            android:visibility="gone" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/weather_apparent_icon"
                            android:layout_width="14dp"
                            android:layout_height="18dp"
                            android:scaleType="fitCenter"
                            android:visibility="gone" />
                        <ImageView
                            android:id="@+id/weather_apparent_person_icon"
                            android:layout_width="14dp"
                            android:layout_height="18dp"
                            android:scaleType="fitCenter"
                            android:visibility="gone"
                            android:layout_marginRight="4dp" />
                        <TextView
                            android:id="@+id/weather_apparent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:visibility="gone" />
                        <ImageView
                            android:id="@+id/weather_apparent_font"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleType="centerInside"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/weather_temperature_row"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:gravity="center">
                    <ImageView
                        android:id="@+id/weather_icon"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        android:layout_marginRight="4dp" />
                    <TextView
                        android:id="@+id/weather_temperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:visibility="gone" />
                    <ImageView
                        android:id="@+id/weather_temperature_font"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleType="centerInside"
                        android:visibility="gone" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical|end">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/weather_probability_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:scaleType="fitCenter"
                            android:visibility="gone"
                            android:layout_marginRight="4dp" />
                        <TextView
                            android:id="@+id/weather_probability"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:visibility="gone" />
                        <ImageView
                            android:id="@+id/weather_probability_font"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleType="centerInside"
                            android:visibility="gone" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center_vertical">
                        <ImageView
                            android:id="@+id/weather_precipitation_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:scaleType="fitCenter"
                            android:visibility="gone"
                            android:layout_marginRight="4dp" />
                        <TextView
                            android:id="@+id/weather_precipitation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:visibility="gone" />
                        <ImageView
                            android:id="@+id/weather_precipitation_font"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleType="centerInside"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/weather_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/weather_status_font"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                android:visibility="gone" />
        </FrameLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="32dp">
            <TextView
                android:id="@+id/weather_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/weather_summary_font"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
